{
  "name": "dsh-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Unofficial desktop app for DeepSeek Harness (dsh): installs and updates the runtime, owns the server process and storage, and wraps the web UI in a window.",
  "author": {
    "name": "Hu Yang",
    "url": "https://github.com/huyang218"
  },
  "contributors": [
    {
      "name": "Hu Yang",
      "url": "https://github.com/huyang218"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyang218/dsh-desktop.git"
  },
  "homepage": "https://github.com/huyang218/dsh-desktop",
  "bugs": "https://github.com/huyang218/dsh-desktop/issues",
  "type": "module",
  "main": "src/boot.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "seed": "node scripts/prepare-seed.mjs && node scripts/prepare-node.mjs",
    "predist": "npm run seed",
    "dist": "electron-builder --dir --publish never",
    "predist:mac": "npm run seed",
    "dist:mac": "electron-builder --mac dmg --publish never",
    "predist:win": "npm run seed",
    "dist:win": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "io.github.huyang218.dsh-desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "seed.tar",
        "to": "runtime-seed.tar"
      },
      {
        "from": "node-runtime.tgz",
        "to": "node-runtime.tgz"
      },
      {
        "from": "node-runtime.version",
        "to": "node-runtime.version"
      }
    ],
    "win": {
      "icon": "assets/icon-1024.png",
      "target": [
        "nsis",
        "dir"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "identity": null,
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "需要访问此位置,以便安装和加载存放在这里的 dsh 插件。 / Needed to install and load dsh plugins kept here.",
        "NSDownloadsFolderUsageDescription": "需要访问此位置,以便安装和加载存放在这里的 dsh 插件。 / Needed to install and load dsh plugins kept here.",
        "NSDesktopFolderUsageDescription": "需要访问此位置,以便安装和加载存放在这里的 dsh 插件。 / Needed to install and load dsh plugins kept here.",
        "NSRemovableVolumesUsageDescription": "需要访问此位置,以便安装和加载存放在这里的 dsh 插件。 / Needed to install and load dsh plugins kept here."
      }
    }
  }
}
