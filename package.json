{
  "name": "dsh-desktop",
  "version": "0.1.14",
  "private": true,
  "description": "Unofficial desktop app for DeepSeek Harness (dsh): installs and updates the runtime, owns the server process and storage, and wraps the web UI in a window.",
  "author": {
    "name": "Hu Yang",
    "email": "guxinglei218@qq.com",
    "url": "https://github.com/huyang218"
  },
  "contributors": [
    {
      "name": "Hu Yang",
      "email": "guxinglei218@qq.com",
      "url": "https://github.com/huyang218"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huyang218/dsh-desktop.git"
  },
  "homepage": "https://github.com/huyang218/dsh-desktop",
  "bugs": "https://github.com/huyang218/dsh-desktop/issues",
  "type": "module",
  "main": "src/boot.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start-dev.mjs",
    "start:electron": "electron .",
    "seed": "node scripts/prepare-seed.mjs && node scripts/prepare-node.mjs",
    "predist": "npm run seed",
    "dist": "electron-builder --config electron-builder.config.cjs --dir --publish never",
    "predist:mac": "npm run seed",
    "dist:mac": "electron-builder --config electron-builder.config.cjs --mac dmg --publish never",
    "predist:win": "npm run seed",
    "dist:win": "electron-builder --config electron-builder.config.cjs --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  }
}
